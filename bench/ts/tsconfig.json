{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "target": "es2022",
    "lib": ["es2022"],
    "types": [],
    "verbatimModuleSyntax": true
  },
  "include": ["*.ts"]
}
